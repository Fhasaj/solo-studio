# SQLite side files (changes are merged into the .sqlite files)
db/*.sqlite-wal
db/*.sqlite-shm

# Databases hold your clients' data: never commit them
db/*.sqlite*

# Case study image uploads (a volume in production)
/uploads/
# Client code handovers (encrypted, on the database volume)
db/handover/
