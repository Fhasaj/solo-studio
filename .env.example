# Public address of the site, used for canonical links, the sitemap and links in emails
SITE_URL=https://example.com

# Admin sign-in: password, then a 6-digit code emailed to ADMIN_EMAIL (set here only, so it can't be changed from the admin)
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Signs admin and client sessions (32+ random characters): openssl rand -base64 48
SECRET_KEY=
# Encrypts bank details and code handovers: openssl rand -base64 32
# Keep a copy somewhere safe: if it's lost, encrypted data can't be read
DATA_ENCRYPTION_KEY=

# Outgoing email (contact form, bookings, sign-in codes, client portal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Contact form messages go here
EMAIL_TO=

# Optional card payments: from the Stripe dashboard (Developers → API keys, and a webhook for
# https://your-domain/api/stripe/webhook listening to checkout.session.completed and checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional overrides
# DB_DIR=            defaults to ./db (/app/db in Docker)
# UPLOAD_DIR=        defaults to ./uploads (/app/uploads in Docker)
# HANDOVER_DIR=      defaults to <DB_DIR>/handover
# INDEXNOW_KEY=      defaults to a key derived from SECRET_KEY
